---
// QuicX 官网 Landing（中英共享组件）
// 设计原则：首页自成一体讲完"是什么/凭什么/怎么上手"，导航以页内锚点为主，文档只留一个入口
import logoImport from '../../logo.png';
import '../styles/landing.css';

// Astro 图片 import 返回 { src, width, height } 元数据对象，取 .src 得 URL
const logo = logoImport.src ?? logoImport.default ?? logoImport;

const { lang } = Astro.props;
const GITHUB = 'https://github.com/caozhiyi/quicX';
const BASE = '/docs/quicx';

// 终端演示（真实命令与真实输出，取自 hello_world 示例）
const TERM_CMD = 'cmd', TERM_OUT = 'out', TERM_OK = 'ok';
const term = [
  { type: TERM_CMD, text: 'git clone --recurse-submodules github.com/caozhiyi/quicX' },
  { type: TERM_CMD, text: 'cmake -B build -DCMAKE_BUILD_TYPE=Release' },
  { type: TERM_CMD, text: 'cmake --build build --parallel 12' },
  { type: TERM_CMD, text: './build/example/hello_world/hello_world_server &' },
  { type: TERM_OUT, text: 'hello_world_server listening on 0.0.0.0:7001' },
  { type: TERM_CMD, text: './build/example/hello_world/hello_world_client' },
  { type: TERM_OUT, text: '======== Response Received ========' },
  { type: TERM_OK,  text: 'Status: 200   Body: hello world' },
];

const T = {
  zh: {
    lang: 'zh-CN',
    title: 'QuicX — 从 UDP 网卡到 HTTP/3 的全链路 QUIC 协议栈',
    description: '面向生产的 C++17 QUIC / HTTP/3 协议栈：1523 项测试、90.60% 互通通过率、工程级可读的单仓库全链路实现。',
    nav: { features: '特性', interop: '互通', arch: '架构', quickstart: '快速开始', docs: '文档' },
    altLangLabel: 'EN', altLangHref: `${BASE}/en/`,
    eyebrow: '开源 · BSD-3-Clause · C++17 · RFC 9000 / 9369 / 9114',
    h1a: '从 UDP 网卡到 HTTP/3 handler，', h1b: '全链路自包含的 QUIC 协议栈',
    sub: '生产级健壮，工程级可读。单仓库实现 TLS 1.3、QUIC 传输、HTTP/3 路由与 QPACK 全栈，不依赖任何外部 HTTP 框架；自 1.0 起公开 API 遵循语义化版本。',
    ctaPrimary: '快速开始', ctaPathLabel: '源码导览 →',
    stats: [
      { n: '1523', label: '单元与集成测试' },
      { n: '90.60%', label: '互通通过率（24 场景 × 17 对端）' },
      { n: '3', label: '份 RFC 完整实现' },
      { n: '80,000+', label: '行 C++ 代码' },
      { n: '18', label: '个开箱示例' },
    ],
    featuresTitle: '为什么是 QuicX',
    cards: [
      { h: '生产级健壮', p: '1523 项单元与集成测试，ASan / UBSan / TSan 全绿发布，健壮性经得起生产检验。' },
      { h: '互通实证', p: '与 17 个主流 QUIC 实现跑通 24 场景互通矩阵，90.60% 通过——协议正确性有据可查。' },
      { h: '工程级可读', p: '网卡 → 加密握手 → 帧编解码 → HTTP/3 逐层贯通，配套 11 站源码阅读路径，排查与二次开发省力。' },
      { h: '开箱即用', p: 'hello_world、文件传输、server push、压测工具……18 个示例即改即用，CMake / Bazel 双构建。' },
    ],
    interopTitle: '互通性，一场景一场景验出来',
    interopP1: '与 17 个主流 QUIC 实现对跑 24 个场景的互通矩阵——握手、迁移、拥塞控制、连接关闭逐一过关，90.60% 通过率全部留痕可查。',
    interopP2: '这不是自我声明，是可复现的测试矩阵。',
    interopLink: '查看互通矩阵 →', interopHref: `${BASE}/zh/guide/interop_overview/`,
    archTitle: '单进程 · 五模块',
    archDesc: '请求自上而下：用户 handler → HTTP/3 Connection / QPACK / Router → QUIC Stream 与拥塞控制 → 通用网络与缓冲 → UDP 出网卡。虚线是浏览器收到 Alt-Svc 后的客户端重连跳变。',
    quickTitle: '四行代码，HTTP/3 落地',
    quickSub: '一个 lambda 就是一个 handler。真实的 hello_world，没有省略任何一行注册代码。',
    quickNote: '构建产物包含全部 18 个示例，从 example/hello_world 开始。',
    exploreTitle: '深入 QuicX',
    explores: [
      { h: '文档中心', p: '快速上手、构建集成、测试与调试指南' },
      { h: '学习路径', p: '11 站源码漫游：从线程模型到 QPACK' },
      { h: '设计剖析', p: '14 篇深度设计文档，先读「一个包的一生」' },
    ],
    docsHref: `${BASE}/zh/overview/`, pathHref: `${BASE}/zh/learning_path/`,
    designHref: `${BASE}/zh/design/packet_lifecycle/`, quickHref: `${BASE}/zh/getting-started/build/`,
    footer: {
      project: '项目', doc: '文档', lang: '语言',
      github: 'GitHub', release: '发布版本', license: 'BSD-3-Clause 许可证',
      build: '构建指南', path: '学习路径', design: '设计剖析', interop: '互通矩阵',
      zh: '简体中文', en: 'English',
    },
  },
  en: {
    lang: 'en',
    title: 'QuicX — A Self-Contained QUIC Stack from the UDP Socket to HTTP/3',
    description: 'A production-ready C++17 QUIC / HTTP/3 protocol stack: 1523 tests, a 90.60% interop pass rate, and a readable single-repository implementation of the full stack.',
    nav: { features: 'Features', interop: 'Interop', arch: 'Architecture', quickstart: 'Quick Start', docs: 'Docs' },
    altLangLabel: '中文', altLangHref: `${BASE}/`,
    eyebrow: 'Open Source · BSD-3-Clause · C++17 · RFC 9000 / 9369 / 9114',
    h1a: 'From the UDP socket to the HTTP/3 handler,', h1b: 'a self-contained QUIC stack',
    sub: 'Production-grade robustness, engineered for readability. A single repository implementing TLS 1.3, the QUIC transport, HTTP/3 routing and QPACK — with no external HTTP framework. Public API follows semantic versioning since 1.0.',
    ctaPrimary: 'Get Started', ctaPathLabel: 'Walk the source →',
    stats: [
      { n: '1523', label: 'unit & integration tests' },
      { n: '90.60%', label: 'interop pass rate (24 × 17 peers)' },
      { n: '3', label: 'RFCs fully implemented' },
      { n: '80,000+', label: 'lines of C++' },
      { n: '18', label: 'runnable examples' },
    ],
    featuresTitle: 'Why QuicX',
    cards: [
      { h: 'Production-Grade Robustness', p: '1523 unit and integration tests; ASan / UBSan / TSan all green on every release.' },
      { h: 'Proven Interoperability', p: 'Validated against 17 major QUIC implementations across a 24-scenario matrix, 90.60% passing.' },
      { h: 'Engineered for Readability', p: 'Every layer from NIC to HTTP/3, with an 11-stop guided source tour — debugging and hacking made easy.' },
      { h: 'Batteries Included', p: 'hello_world, file transfer, server push, load testing — 18 ready-to-run examples, CMake & Bazel.' },
    ],
    interopTitle: 'Interoperability, scenario by scenario',
    interopP1: 'A 24-scenario interop matrix run against 17 major QUIC implementations — handshakes, migration, congestion control and connection close, each verified individually. The 90.60% pass rate is recorded and reproducible.',
    interopP2: 'Not a self-declaration — a reproducible test matrix.',
    interopLink: 'See the interop matrix →', interopHref: `${BASE}/en/guide/interop_overview/`,
    archTitle: 'Single Process · Five Modules',
    archDesc: 'Requests flow top to bottom: user handler → HTTP/3 Connection / QPACK / Router → QUIC stream & congestion control → common networking → UDP out of the NIC. The dashed line marks the browser-side reconnect hop after receiving Alt-Svc.',
    quickTitle: 'HTTP/3 in four lines',
    quickSub: 'One lambda is one handler. The real hello_world — no registration code omitted.',
    quickNote: 'The build ships all 18 examples — start with example/hello_world.',
    exploreTitle: 'Go Deeper',
    explores: [
      { h: 'Documentation', p: 'Quick start, builds & integration, testing guides' },
      { h: 'Learning Path', p: 'An 11-stop tour of the source, from the threading model to QPACK' },
      { h: 'Design Deep-Dives', p: '14 in-depth design notes — start with “The Life of a Packet”' },
    ],
    docsHref: `${BASE}/en/overview/`, pathHref: `${BASE}/en/learning_path/`,
    designHref: `${BASE}/en/design/packet_lifecycle/`, quickHref: `${BASE}/en/getting-started/build/`,
    footer: {
      project: 'Project', doc: 'Docs', lang: 'Language',
      github: 'GitHub', release: 'Releases', license: 'BSD-3-Clause License',
      build: 'Build Guide', path: 'Learning Path', design: 'Design Notes', interop: 'Interop Matrix',
      zh: '简体中文', en: 'English',
    },
  },
};
const t = T[lang];
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/png" href={logo} />
    <script is:inline>
      const t = localStorage.getItem('starlight-theme')
        ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={BASE + (lang === 'zh' ? '/' : '/en/')}>
          <img src={logo} alt="QuicX" width="81" height="27" />
        </a>
        <nav class="nav-links">
          <a href="#features">{t.nav.features}</a>
          <a href="#interop">{t.nav.interop}</a>
          <a href="#architecture">{t.nav.arch}</a>
          <a href="#quickstart">{t.nav.quickstart}</a>
          <a href={t.docsHref}>{t.nav.docs}</a>
        </nav>
        <div class="nav-actions">
          <a class="gh" href={GITHUB} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-1.94c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12v3.15c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
            <span>GitHub</span>
          </a>
          <a class="lang" href={t.altLangHref}>{t.altLangLabel}</a>
          <button id="theme-toggle" aria-label="Toggle theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero：左文案右终端 -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow">{t.eyebrow}</p>
            <h1>{t.h1a}<br />{t.h1b}</h1>
            <p class="sub">{t.sub}</p>
            <div class="cta">
              <a class="btn primary" href="#quickstart">{t.ctaPrimary}</a>
              <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
              <a class="text-link" href={t.pathHref}>{t.ctaPathLabel}</a>
            </div>
          </div>
          <div class="hero-term reveal">
            <div class="terminal">
              <div class="term-bar"><i></i><i></i><i></i><span>bash — quicX</span></div>
              <div class="term-body">
                {term.map((l) =>
                  l.type === TERM_CMD ? <span class="tl"><em>$</em>{l.text}</span>
                  : l.type === TERM_OK ? <span class="tl ok">{l.text}</span>
                  : <span class="tl out">{l.text}</span>
                )}
                <span class="tl"><em>$</em><i class="cursor"></i></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 数字带 -->
      <section class="stats reveal">
        {t.stats.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)}
      </section>

      <!-- 特性 -->
      <section id="features" class="section features">
        <h2>{t.featuresTitle}</h2>
        <div class="cards">
          <div class="card reveal">
            <div class="card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <h3>{t.cards[0].h}</h3><p>{t.cards[0].p}</p>
          </div>
          <div class="card reveal">
            <div class="card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg></div>
            <h3>{t.cards[1].h}</h3><p>{t.cards[1].p}</p>
          </div>
          <div class="card reveal">
            <div class="card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
            <h3>{t.cards[2].h}</h3><p>{t.cards[2].p}</p>
          </div>
          <div class="card reveal">
            <div class="card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7L12 12l8.7-5M12 22V12"/></svg></div>
            <h3>{t.cards[3].h}</h3><p>{t.cards[3].p}</p>
          </div>
        </div>
      </section>

      <!-- 互通矩阵 -->
      <section id="interop" class="section interop reveal">
        <div class="interop-grid">
          <div class="donut-wrap">
            <svg viewBox="0 0 120 120" class="donut" role="img" aria-label="90.60%">
              <circle cx="60" cy="60" r="52" class="donut-bg" />
              <circle cx="60" cy="60" r="52" class="donut-fg" />
            </svg>
            <div class="donut-label"><strong>90.60%</strong><span>24 × 17</span></div>
          </div>
          <div class="interop-copy">
            <h2>{t.interopTitle}</h2>
            <p>{t.interopP1}</p>
            <p class="interop-note">{t.interopP2}</p>
            <a class="text-link" href={t.interopHref}>{t.interopLink}</a>
          </div>
        </div>
      </section>

      <!-- 架构 -->
      <section id="architecture" class="section arch reveal">
        <h2>{t.archTitle}</h2>
        <div class="pipeline">
          <span class="pipe-node">UDP</span><span class="pipe-arrow">→</span>
          <span class="pipe-node">Packet</span><span class="pipe-arrow">→</span>
          <span class="pipe-node">Frame</span><span class="pipe-arrow">→</span>
          <span class="pipe-node">Stream</span><span class="pipe-arrow">→</span>
          <span class="pipe-node">H3 / QPACK</span><span class="pipe-arrow">→</span>
          <span class="pipe-node">Handler</span>
        </div>
        <p class="arch-desc">{t.archDesc}</p>
        <img src={BASE + '/architecture.svg'} alt="QuicX module architecture" loading="lazy" />
      </section>

      <!-- 快速开始：代码 tabs -->
      <section id="quickstart" class="section quickstart reveal">
        <h2>{t.quickTitle}</h2>
        <p class="quick-sub">{t.quickSub}</p>
        <div class="tabs" data-tabs>
          <div class="tab-btns" role="tablist">
            <button class="tab-btn active" data-tab="code" role="tab">hello_world.cpp</button>
            <button class="tab-btn" data-tab="cmake" role="tab">CMake</button>
            <button class="tab-btn" data-tab="bazel" role="tab">Bazel</button>
          </div>
          <div class="tab-panel active" data-panel="code" role="tabpanel">
            <pre><code><span class="tk-kw">auto</span> server = quicx::IServer::<span class="tk-fn">Create</span>();

server-&gt;<span class="tk-fn">AddHandler</span>(quicx::HttpMethod::kGet, <span class="tk-str">"/hello"</span>,
    [](std::shared_ptr&lt;quicx::IRequest&gt; req,
       std::shared_ptr&lt;quicx::IResponse&gt; resp) &#123;
        resp-&gt;<span class="tk-fn">AppendBody</span>(std::string(<span class="tk-str">"hello world"</span>));
        resp-&gt;<span class="tk-fn">SetStatusCode</span>(<span class="tk-num">200</span>);
    &#125;);

server-&gt;<span class="tk-fn">Init</span>(config);
server-&gt;<span class="tk-fn">Start</span>(<span class="tk-str">"0.0.0.0"</span>, <span class="tk-num">7001</span>);  <span class="tk-cm">// HTTP/3 on the wire</span></code></pre>
          </div>
          <div class="tab-panel" data-panel="cmake" role="tabpanel">
            <pre><code>git clone --recurse-submodules https://github.com/caozhiyi/quicX.git
cd quicX
cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=ON
cmake --build build --parallel $(nproc)</code></pre>
          </div>
          <div class="tab-panel" data-panel="bazel" role="tabpanel">
            <pre><code>git clone --recurse-submodules https://github.com/caozhiyi/quicX.git
cd quicX

<span class="tk-cm"># build every target (library + all 18 examples)</span>
bazel build //...

<span class="tk-cm"># run the full unit-test suite</span>
bazel test //test/...</code></pre>
          </div>
        </div>
        <p class="quickstart-note">{t.quickNote}</p>
      </section>

      <!-- 深入入口 -->
      <section class="section explore">
        <h2>{t.exploreTitle}</h2>
        <div class="explore-cards">
          <a class="explore-card reveal" href={t.docsHref}>
            <strong>{t.explores[0].h}</strong><span>{t.explores[0].p}</span><em>→</em>
          </a>
          <a class="explore-card reveal" href={t.pathHref}>
            <strong>{t.explores[1].h}</strong><span>{t.explores[1].p}</span><em>→</em>
          </a>
          <a class="explore-card reveal" href={t.designHref}>
            <strong>{t.explores[2].h}</strong><span>{t.explores[2].p}</span><em>→</em>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="brand small">
            <img src={logo} alt="QuicX" width="63" height="21" />
          </div>
          <p>C++17 · QUIC · HTTP/3</p>
        </div>
        <div>
          <h4>{t.footer.project}</h4>
          <a href={GITHUB} target="_blank" rel="noopener">{t.footer.github}</a>
          <a href={GITHUB + '/tags'} target="_blank" rel="noopener">{t.footer.release}</a>
          <a href="https://opensource.org/licenses/BSD-3-Clause" target="_blank" rel="noopener">{t.footer.license}</a>
        </div>
        <div>
          <h4>{t.footer.doc}</h4>
          <a href={t.quickHref}>{t.footer.build}</a>
          <a href={t.pathHref}>{t.footer.path}</a>
          <a href={t.designHref}>{t.footer.design}</a>
          <a href={t.interopHref}>{t.footer.interop}</a>
        </div>
        <div>
          <h4>{t.footer.lang}</h4>
          <a href={BASE + '/'}>{t.footer.zh}</a>
          <a href={BASE + '/en/'}>{t.footer.en}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // 主题切换（与文档站共享 starlight-theme key）
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
      });
      // 代码 tabs
      document.querySelectorAll('[data-tabs]').forEach((root) => {
        root.querySelectorAll('.tab-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            root.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('active', b === btn));
            root.querySelectorAll('.tab-panel').forEach((p) =>
              p.classList.toggle('active', p.dataset.panel === btn.dataset.tab));
          });
        });
      });
      // 滚动淡入（尊重系统减弱动效偏好）
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
