---
import type { HighlightItem } from "../data/site";

interface Props {
  title: string;
  intro: string;
  items: HighlightItem[];
}

const { title, intro, items } = Astro.props;
const isZh = Astro.url.pathname.startsWith("/zh");
const sectionLabel = isZh ? "精选内容" : "Curated collection";
const actionLabel = isZh ? "查看内容" : "Explore";
---

<section class="content-section">
  <div class="section-heading">
    <p class="section-heading-meta">{sectionLabel}</p>
    <h2>{title}</h2>
    <p>{intro}</p>
  </div>

  <div class="card-grid">
    {items.map((item, index) => (
      <article class="card">
        <div class="card-topline">
          <p class="card-meta">{item.meta}</p>
          <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
        </div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <a class="card-link" href={item.href}>
          <span>{actionLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</section>
