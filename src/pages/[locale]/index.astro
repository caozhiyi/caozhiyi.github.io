---
import MainLayout from "../../layouts/MainLayout.astro";
import { siteContent, type Locale } from "../../data/site";

export function getStaticPaths() {
  return (Object.keys(siteContent) as Locale[]).map((locale) => ({
    params: { locale }
  }));
}

const locale = Astro.params.locale as Locale;
const content = siteContent[locale];

if (!content) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const byPublishedDesc = <T extends { publishedAt?: string }>(a: T, b: T) => {
  const av = a.publishedAt || "";
  const bv = b.publishedAt || "";
  if (av && bv) return bv.localeCompare(av);
  if (av) return -1;
  if (bv) return 1;
  return 0;
};

// "Start here" reading path: AI engineering + the nature of LLM intelligence + the protocol decade behind it.
const featuredSlugs = ["ai-gateway-as-infra", "llm-intelligence-blackbox", "why-we-need-quic"];
type Writing = (typeof content.writings)[number];
const startHere = featuredSlugs
  .map((slug) => content.writings.find((w) => w.href.includes(slug)))
  .filter((w): w is Writing => Boolean(w));

// Recent timeline proves the site is alive; the articles page keeps the full archive.
const recentArticles = [...content.writings].sort(byPublishedDesc).slice(0, 5);

// Works are listed newest-first, so the order itself tells the turn from protocols to AI.
const books = content.books;
const projects = content.projects;
const latestBook = books[0];

const booksPath = `/${locale}/books/`;
const projectsPath = `/${locale}/projects/`;
const articlesPath = `/${locale}/articles/`;
const aboutPath = `/${locale}/about/`;
const githubUrl = "https://github.com/caozhiyi";

const copy = {
  zh: {
    worksTitle: "书籍与开源项目",
    worksBooks: "书籍",
    worksProjects: "开源项目",
    allBooks: "全部书籍",
    allProjects: "全部项目",
    startHereTitle: "从这里开始读",
    startHereIntro: "精选长文：两篇关于 AI 的深度思考，一篇是过去十年的协议功底。",
    recentTitle: "最近更新",
    allEssays: "全部文章"
  },
  en: {
    worksTitle: "Works & Open Source",
    worksBooks: "Books",
    worksProjects: "Open Source",
    allBooks: "All books",
    allProjects: "All projects",
    startHereTitle: "Start here",
    startHereIntro: "Curated long-form essays: two deep dives into AI, one on low-level protocols.",
    recentTitle: "Recent updates",
    allEssays: "All writing"
  }
}[locale];

const formatShortDate = (value?: string) => {
  if (!value) return null;
  // Use YYYY-MM-DD (already ISO), keep it monospace-friendly for the timeline
  return /^\d{4}-\d{2}-\d{2}$/.test(value) ? value : null;
};

// Structured data: WebSite + Person for the Knowledge Graph
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://caozhiyi.cc";
const localeHomeURL = new URL(`/${locale}/`, siteUrl).href;
const personName = locale === "zh" ? "曹智轶" : "Zhiyi Cao";

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: content.siteTitle,
      url: localeHomeURL,
      inLanguage: locale === "zh" ? "zh-CN" : "en",
      description: content.siteDescription
    },
    {
      "@type": "Person",
      name: personName,
      url: siteUrl,
      sameAs: ["https://github.com/caozhiyi"]
    }
  ]
};

const seoDescription = locale === "zh"
  ? "曹智轶的个人技术网站：系统架构师，深耕高性能网络协议栈与 AI 工程化。汇总精选长文、技术书籍与开源项目。"
  : "Zhiyi Cao's personal engineering hub: systems architect focused on high-performance networking and AI engineering.";
---

<MainLayout
  content={content}
  pageTitle={content.nav[0].label}
  fullTitle={content.homeTitle}
  description={seoDescription}
  jsonLd={homeJsonLd}
>
  <div class="tech-blueprint">
    <div class="bp-grid-container">
      <!-- ① Articles: Start here (editorial pick) + Recent timeline -->
      <div class="bp-home-lower">
        <div class="bp-section tech-border">
          <div class="bp-sec-header">
            <h2>{copy.startHereTitle}</h2>
          </div>
          <p class="bp-section-intro">{copy.startHereIntro}</p>
          <div class="bp-starthere-list">
            {startHere.map((item) => (
              <a class="bp-starthere-item" href={item.href}>
                <span class="bp-starthere-meta">{item.meta}</span>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </a>
            ))}
          </div>
        </div>

        <div class="bp-section tech-border">
          <div class="bp-sec-header">
            <h2>{copy.recentTitle}</h2>
          </div>
          <div class="bp-articles-list">
            {recentArticles.map((item) => {
              const shortDate = formatShortDate(item.publishedAt);
              return (
                <div class="bp-article-item">
                  <div class="bp-article-meta">
                    <span class="bp-article-date">
                      {shortDate ? (
                        <time datetime={item.publishedAt}>{shortDate}</time>
                      ) : (
                        item.meta.split(' · ')[1] || 'RECENT'
                      )}
                    </span>
                    <span class="bp-article-series">[{item.meta.split(' · ')[0]}]</span>
                  </div>
                  <h3><a href={item.href}>{item.title}</a></h3>
                </div>
              );
            })}
          </div>
          <div class="bp-section-footer">
            <a class="bp-more-link" href={articlesPath}>{copy.allEssays} →</a>
          </div>
        </div>
      </div>

      <!-- ② Works: Books and Open Source projects -->
      <div class="bp-section tech-border">
        <div class="bp-sec-header">
          <h2>{copy.worksTitle}</h2>
        </div>
        <div class="bp-works-grid">
          <div class="bp-works-col">
            <h3 class="bp-works-col-title">{copy.worksBooks}</h3>
            <div class="bp-works-cards">
              {books.map((item) => (
                <a class="bp-work-card" href={item.href}>
                  <div class="bp-work-card-header">
                    <span class="bp-work-tag">{item.meta.split(' · ')[1] || item.meta}</span>
                    <span class="bp-work-arrow" aria-hidden="true">→</span>
                  </div>
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                </a>
              ))}
            </div>
            <a class="bp-works-more" href={booksPath}>{copy.allBooks} →</a>
          </div>
          <div class="bp-works-col">
            <h3 class="bp-works-col-title">{copy.worksProjects}</h3>
            <div class="bp-works-cards">
              {projects.map((item) => (
                <a class="bp-work-card" href={item.href} target="_blank" rel="noopener noreferrer">
                  <div class="bp-work-card-header">
                    <span class="bp-work-tag">{item.meta.split(' · ')[1] || 'C++'}</span>
                    <span class="bp-work-arrow" aria-hidden="true">↗</span>
                  </div>
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                </a>
              ))}
            </div>
            <a class="bp-works-more" href={projectsPath}>{copy.allProjects} →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ locale }}>
    localStorage.setItem("preferred-locale", locale);
  </script>
</MainLayout>

<style>
  /* Works: 2-column cards layout */
  .bp-works-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .bp-works-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bp-works-col-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tech-text-muted);
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--tech-border);
  }

  .bp-works-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bp-work-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--tech-border);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .bp-work-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .bp-work-card:hover {
    border-bottom-color: var(--tech-border-strong);
  }

  .bp-work-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bp-work-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--tech-border);
    color: var(--tech-text-muted);
    background: var(--tech-tag-bg);
    white-space: nowrap;
  }

  .bp-work-card strong {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--tech-text);
    line-height: 1.4;
  }

  .bp-work-card:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .bp-work-card p {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--tech-text-muted);
    margin: 0;
  }

  .bp-work-arrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--tech-text-muted);
  }

  .bp-works-more {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--tech-text-muted);
    text-decoration: none;
    margin-top: 4px;
    align-self: flex-start;
    border-bottom: 1px solid transparent;
  }

  .bp-works-more:hover {
    color: var(--tech-text);
    border-bottom-color: var(--tech-text);
  }

  /* Section intro line */
  .bp-section-intro {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--tech-text-muted);
    margin: 0 0 18px 0;
  }

  /* ③ Start here: editorial picks with description */
  .bp-starthere-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bp-starthere-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--tech-border);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .bp-starthere-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .bp-starthere-item:hover {
    border-bottom-color: var(--tech-border-strong);
  }

  .bp-starthere-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--tech-text-muted);
  }

  .bp-starthere-item strong {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--tech-text);
    line-height: 1.4;
  }

  .bp-starthere-item:hover strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .bp-starthere-item p {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--tech-text-muted);
    margin: 0;
  }

  /* ④ Section footer */
  .bp-section-footer {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    justify-content: flex-end;
    gap: 20px;
  }

  .bp-more-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--tech-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .bp-more-link:hover {
    color: var(--tech-text);
    border-bottom-color: var(--tech-text);
  }

  /* Lower row: start here + recent */
  .bp-home-lower {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .bp-works-grid,
    .bp-home-lower {
      grid-template-columns: 1fr;
    }
  }
</style>
