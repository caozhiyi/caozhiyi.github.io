---
import MainLayout from "../../../layouts/MainLayout.astro";
import { siteContent, type Locale } from "../../../data/site";
import QRCode from "qrcode";

// Pre-compute which (locale, slug) combinations actually exist as article files.
// This is used both by getStaticPaths and to decide whether a matching page
// exists in the opposite locale (for hreflang alternate emission).
const allPostsMap = import.meta.glob("../../../articles/**/*.md", { eager: true });
const localeSlugSets: Record<string, Set<string>> = { zh: new Set(), en: new Set() };
for (const path of Object.keys(allPostsMap)) {
  const parts = path.split("/");
  const filename = parts.pop() || "";
  const fileSlug = filename.replace(/\.md$/, "");
  parts.pop(); // drop category
  const fileLocale = parts.pop() || "";
  if (fileLocale === "zh" || fileLocale === "en") {
    localeSlugSets[fileLocale].add(fileSlug);
  }
}

export async function getStaticPaths() {
  // Note: getStaticPaths runs in an isolated scope and cannot see frontmatter
  // variables, so the glob must be repeated here instead of reusing allPostsMap.
  const postsMap = import.meta.glob("../../../articles/**/*.md", { eager: true });
  return Object.entries(postsMap).map(([path, post]: [string, any]) => {
    const parts = path.split("/");
    const filename = parts.pop() || "";
    const slug = filename.replace(/\.md$/, "");
    const category = parts.pop() || ""; // e.g., systems, ai, career
    const locale = parts.pop() || ""; // e.g., zh, en
    return {
      params: { locale, slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = post;

// Extract title from the raw markdown content or filename
const rawContent = post.rawContent();
const titleLine = rawContent.split("\n").find((line) => line.trim().startsWith("# "));
const title = titleLine ? titleLine.replace(/#\s*/, "").replace(/\s*->\s*done\s*$/, "").trim() : "文章";

const locale = Astro.params.locale as Locale;
const content = siteContent[locale];

// Find this article's metadata: first in flat writings, then in grouped writings
const slug = Astro.params.slug;
const matchSlug = (href: string) => href.endsWith(`/${slug}`) || href.endsWith(`/${slug}/`);
const articleMeta =
  content.writings.find((item) => matchSlug(item.href)) ||
  content.writingGroups
    .flatMap((group) => group.items)
    .find((item) => matchSlug(item.href));

// Per-article SEO overrides live in each markdown file's frontmatter
// (seoTitle / description); site.ts entries act as fallback. The visible
// h1 and breadcrumb always keep the literary title.
const frontmatter = post.frontmatter ?? {};
const description = frontmatter.description || articleMeta?.description || content.siteDescription;
const publishedAt = articleMeta?.publishedAt;
const seoTitle = frontmatter.seoTitle || articleMeta?.seoTitle;

// Whether the article also exists in the opposite locale. If not, we should
// NOT emit an hreflang alternate link, otherwise Google will crawl a 404 URL.
const oppositeLocale = locale === "zh" ? "en" : "zh";
const hasOppositeLocale = localeSlugSets[oppositeLocale]?.has(String(slug)) ?? false;

// Site & URL constants for structured data
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://caozhiyi.cc";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const homeURL = new URL(`/${locale}/`, siteUrl).href;
const articlesIndexURL = new URL(`/${locale}/articles/`, siteUrl).href;
const rssFeedURL = new URL(`/${locale}/rss.xml`, siteUrl).href;

// Related reading (topical cross-links to book chapters) + subscription UI.
const related = articleMeta?.related;
const uiLabels = locale === "zh"
  ? { relatedTitle: "相关阅读", subscribeText: "想第一时间读到下一篇？", subscribeLink: "RSS 订阅" }
  : { relatedTitle: "Related Reading", subscribeText: "Want the next post as it ships?", subscribeLink: "Subscribe via RSS" };

const authorPerson = {
  "@type": "Person",
  name: locale === "zh" ? "曹智轶" : "Zhiyi Cao",
  url: siteUrl,
  sameAs: ["https://github.com/caozhiyi"]
};

const publishedAtISO = publishedAt ? `${publishedAt}T00:00:00+08:00` : undefined;

const blogPostingLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: seoTitle ?? title,
  description,
  url: canonicalURL,
  inLanguage: locale === "zh" ? "zh-CN" : "en",
  author: authorPerson,
  publisher: authorPerson,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL
  }
};
if (publishedAtISO) {
  blogPostingLd.datePublished = publishedAtISO;
  blogPostingLd.dateModified = publishedAtISO;
}

const breadcrumbLabels = locale === "zh"
  ? { home: "首页", articles: "文章" }
  : { home: "Home", articles: "Writing" };

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: breadcrumbLabels.home, item: homeURL },
    { "@type": "ListItem", position: 2, name: breadcrumbLabels.articles, item: articlesIndexURL },
    { "@type": "ListItem", position: 3, name: title, item: canonicalURL }
  ]
};

// Human-readable date for the visible <time> element
const publishedDate = publishedAt ? new Date(`${publishedAt}T00:00:00+08:00`) : null;
const publishedDateLabel = publishedDate
  ? new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-US", {
      year: "numeric",
      month: locale === "zh" ? "long" : "long",
      day: "numeric"
    }).format(publishedDate)
  : null;

// Calculate reading stats (word count & estimated reading time)
const getReadingStats = (contentStr: string, currentLocale: Locale) => {
  const clean = contentStr
    .replace(/```[\s\S]*?```/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[(.*?)\]\(.*?\)/g, "$1")
    .replace(/<[^>]+>/g, "");
  const cjk = (clean.match(/[\u4e00-\u9fff]/g) || []).length;
  const words = (clean.match(/[a-zA-Z0-9_\-]+/g) || []).length;
  const totalWords = cjk + words;
  const minutes = Math.max(1, Math.round(cjk / 350 + words / 220));
  const formattedCount = totalWords.toLocaleString();
  const label = currentLocale === "zh"
    ? `${formattedCount} 字 · 约 ${minutes} 分钟阅读`
    : `${formattedCount} words · ~${minutes} min read`;
  return { totalWords, minutes, label };
};

const readingStats = getReadingStats(rawContent, locale);
blogPostingLd.wordCount = readingStats.totalWords;
blogPostingLd.timeRequired = `PT${readingStats.minutes}M`;

// Share & citation helpers
const authorName = locale === "zh" ? "曹智轶" : "Zhiyi Cao";
const markdownCitation = `[${title} - ${authorName}](${canonicalURL})`;
const qrCodeSvg = locale === "zh"
  ? await QRCode.toString(canonicalURL, {
      type: "svg",
      margin: 1,
      width: 140,
      color: {
        dark: "#09090b",
        light: "#ffffff"
      }
    })
  : "";
---

<MainLayout
  content={content}
  pageTitle={seoTitle ?? title}
  description={description}
  pageType="article"
  publishedAt={publishedAt}
  jsonLd={[blogPostingLd, breadcrumbLd]}
  hasOppositeLocale={hasOppositeLocale}
>
  <div class="article-detail-layout">
    <!-- Floating Side Dock -->
    <aside class="article-floating-dock" aria-label={locale === "zh" ? "快捷操作与分享" : "Quick actions & share"}>
      <div class="dock-pill">
        <!-- 1. Copy URL -->
        <div class="dock-item">
          <button
            type="button"
            class="dock-btn dock-btn-copy"
            data-dock-copy-url={canonicalURL}
            title={locale === "zh" ? "复制链接" : "Copy link"}
            aria-label={locale === "zh" ? "复制链接" : "Copy link"}
          >
            <span class="dock-icon-default">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </span>
            <span class="dock-icon-success" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
          </button>
          <span class="dock-tooltip" role="tooltip">{locale === "zh" ? "复制链接" : "Copy link"}</span>
        </div>

        <!-- 2. Copy Markdown citation -->
        <div class="dock-item">
          <button
            type="button"
            class="dock-btn dock-btn-md"
            data-dock-copy-md={markdownCitation}
            title={locale === "zh" ? "复制 Markdown 链接" : "Copy Markdown link"}
            aria-label={locale === "zh" ? "复制 Markdown 链接" : "Copy Markdown link"}
          >
            <span class="dock-icon-default">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M14.85 3H1.15C.52 3 0 3.52 0 4.15v7.69C0 12.48.52 13 1.15 13h13.69c.64 0 1.15-.52 1.15-1.15V4.15C16 3.52 15.48 3 14.85 3zM9 11H7V8l-1.5 1.9L4 8v3H2V5h2l1.5 2L7 5h2v6zm2.99.5L9.5 8H11V5h2v3h1.5l-2.51 3.5z"/></svg>
            </span>
            <span class="dock-icon-success" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
          </button>
          <span class="dock-tooltip" role="tooltip">{locale === "zh" ? "复制 Markdown 链接" : "Copy Markdown link"}</span>
        </div>

        {locale === "zh" ? (
          <>
            <!-- 3. WeChat QR Popover (ZH) -->
            <div class="dock-item dock-wechat-wrapper">
              <button
                type="button"
                class="dock-btn dock-btn-wechat"
                data-dock-wechat-toggle
                title="微信扫码阅读"
                aria-label="微信扫码阅读"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8.5 2C3.8 2 0 5.3 0 9.4c0 2.3 1.2 4.4 3.1 5.8l-.8 2.5 2.9-1.5c1 .3 2.1.5 3.3.5.3 0 .7 0 1-.1-.3-.9-.5-1.8-.5-2.7 0-4.4 3.8-8 8.5-8 .5 0 1 0 1.5.1C17.6 4.3 13.4 2 8.5 2zm10 6c-3.9 0-7 2.7-7 6s3.1 6 7 6c.9 0 1.8-.2 2.6-.5l2.4 1.2-.6-2.1c1.6-1.1 2.6-2.8 2.6-4.6 0-3.3-3.1-6-7-6z"/></svg>
              </button>
              <span class="dock-tooltip" role="tooltip">微信扫码阅读</span>
              <div class="dock-qr-popover" data-dock-qr-popover>
                <div class="dock-qr-header">
                  <span class="dock-qr-title">微信扫码阅读</span>
                  <button type="button" class="dock-qr-close" data-dock-qr-close aria-label="关闭">×</button>
                </div>
                <div class="dock-qr-code" set:html={qrCodeSvg} />
                <p class="dock-qr-desc">在微信扫码可直接在手机上阅读或转发</p>
              </div>
            </div>

            <!-- 4. X (Twitter) -->
            <div class="dock-item">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dock-btn"
                title="分享至 X (Twitter)"
                aria-label="分享至 X (Twitter)"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">分享至 X</span>
            </div>

            <!-- 5. Email Forward -->
            <div class="dock-item">
              <a
                href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(canonicalURL)}`}
                class="dock-btn"
                title="通过邮件分享"
                aria-label="通过邮件分享"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">邮件转发</span>
            </div>
          </>
        ) : (
          <>
            <!-- 3. X (Twitter) (EN) -->
            <div class="dock-item">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dock-btn"
                title="Share on X (Twitter)"
                aria-label="Share on X"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">Share on X</span>
            </div>

            <!-- 4. Bluesky -->
            <div class="dock-item">
              <a
                href={`https://bsky.app/intent/compose?text=${encodeURIComponent(title + " " + canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dock-btn"
                title="Share on Bluesky"
                aria-label="Share on Bluesky"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566 1.01 1.6 1.62 1.6 3.65c0 1.15.54 8.7 1.06 10.15.7 1.95 2.92 2.63 4.88 2.2-2.86 1.04-4.82 3.12-2.73 5.48 2.76 3.12 6.13-.7 7.19-2.92 1.06 2.22 4.43 6.04 7.19 2.92 2.09-2.36.13-4.44-2.73-5.48 1.96.43 4.18-.25 4.88-2.2.52-1.45 1.06-9 1.06-10.15 0-2.03-.966-2.64-3.602-.845C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">Share on Bluesky</span>
            </div>

            <!-- 5. LinkedIn -->
            <div class="dock-item">
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dock-btn"
                title="Share on LinkedIn"
                aria-label="Share on LinkedIn"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.69-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">Share on LinkedIn</span>
            </div>

            <!-- 6. Telegram -->
            <div class="dock-item">
              <a
                href={`https://t.me/share/url?url=${encodeURIComponent(canonicalURL)}&text=${encodeURIComponent(title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="dock-btn"
                title="Share on Telegram"
                aria-label="Share on Telegram"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.18 3.35-1.38 3.73-1.39.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              </a>
              <span class="dock-tooltip" role="tooltip">Share on Telegram</span>
            </div>
          </>
        )}

        <div class="dock-divider" role="separator"></div>

        <!-- Back to Top -->
        <div class="dock-item">
          <button
            type="button"
            class="dock-btn dock-btn-top"
            data-dock-back-to-top
            title={locale === "zh" ? "回到顶部" : "Back to top"}
            aria-label={locale === "zh" ? "回到顶部" : "Back to top"}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
          <span class="dock-tooltip" role="tooltip">{locale === "zh" ? "回到顶部" : "Back to top"}</span>
        </div>
      </div>
    </aside>

    <article class="page-panel article-card">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>{breadcrumbLabels.home}</a>
        <span class="article-breadcrumb-sep" aria-hidden="true">›</span>
        <a href={`/${locale}/articles/`}>{breadcrumbLabels.articles}</a>
        <span class="article-breadcrumb-sep" aria-hidden="true">›</span>
        <span class="article-breadcrumb-current">{title}</span>
      </nav>
      <p class="article-meta-published">
        {publishedDate && publishedDateLabel && (
          <time datetime={publishedAt}>{publishedDateLabel}</time>
        )}
        {publishedDate && <span class="article-meta-sep" aria-hidden="true">·</span>}
        <span class="article-reading-stats">{readingStats.label}</span>
      </p>
      <div class="markdown-body">
        <Content />
      </div>

      <div class="article-share-bar">
        <span class="share-label">{locale === 'zh' ? '分享本文' : 'Share this article'}</span>
        <div class="share-btn-group">
          <button class="share-btn" data-share-copy type="button" aria-label={locale === 'zh' ? '复制链接' : 'Copy link'}>
            <svg class="share-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <span class="share-btn-text">{locale === 'zh' ? '复制链接' : 'Copy link'}</span>
          </button>
          <button class="share-btn" data-share-copy-md data-md-text={markdownCitation} type="button" aria-label={locale === 'zh' ? '复制 Markdown 引用' : 'Copy Markdown link'}>
            <svg class="share-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M14.85 3H1.15C.52 3 0 3.52 0 4.15v7.69C0 12.48.52 13 1.15 13h13.69c.64 0 1.15-.52 1.15-1.15V4.15C16 3.52 15.48 3 14.85 3zM9 11H7V8l-1.5 1.9L4 8v3H2V5h2l1.5 2L7 5h2v6zm2.99.5L9.5 8H11V5h2v3h1.5l-2.51 3.5z"/></svg>
            <span class="share-btn-text">{locale === 'zh' ? '复制 MD' : 'Copy MD'}</span>
          </button>
          <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
            <svg class="share-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>X</span>
          </a>
          {locale === 'zh' ? (
            <a class="share-btn" href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(canonicalURL)}`} aria-label="通过邮件分享">
              <svg class="share-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              <span>邮件</span>
            </a>
          ) : (
            <>
              <a class="share-btn" href={`https://bsky.app/intent/compose?text=${encodeURIComponent(title + " " + canonicalURL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky">
                <svg class="share-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566 1.01 1.6 1.62 1.6 3.65c0 1.15.54 8.7 1.06 10.15.7 1.95 2.92 2.63 4.88 2.2-2.86 1.04-4.82 3.12-2.73 5.48 2.76 3.12 6.13-.7 7.19-2.92 1.06 2.22 4.43 6.04 7.19 2.92 2.09-2.36.13-4.44-2.73-5.48 1.96.43 4.18-.25 4.88-2.2.52-1.45 1.06-9 1.06-10.15 0-2.03-.966-2.64-3.602-.845C16.046 4.747 13.087 8.686 12 10.8z"/></svg>
                <span>Bluesky</span>
              </a>
              <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
