<script>
  // Only execute if there's at least one Mermaid block on the page
  const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (mermaidBlocks.length > 0) {
    // Dynamically import Mermaid from CDN to keep initial load lightweight
    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');

    // Store original blocks and replace them with container divs
    mermaidBlocks.forEach((pre, index) => {
      // Create a wrapper container for rendering the chart
      const container = document.createElement('div');
      container.className = 'mermaid-container';
      container.id = `mermaid-chart-${index}`;
      
      // Extract the raw diagram code from the pre textContent
      const codeText = pre.textContent || '';
      container.setAttribute('data-mermaid-code', codeText.trim());

      // Insert loading placeholder
      container.innerHTML = '<div class="mermaid-loading">渲染图表中...</div>';

      // Replace pre with the new container
      pre.parentNode?.replaceChild(container, pre);
    });

    let renderId = 0;

    // Render function
    const renderCharts = async () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      
      // Configure Mermaid to match the素色极简 (grayscale/minimalist) aesthetic
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        securityLevel: 'loose',
        // Fine-tune grayscale theme colors for a premium, clean layout
        themeVariables: isDark ? {
          background: '#09090b',
          primaryColor: '#18181b',
          primaryTextColor: '#f4f4f5',
          primaryBorderColor: 'rgba(244, 244, 245, 0.16)',
          lineColor: '#a1a1aa',
          secondaryColor: '#27272a',
          tertiaryColor: '#18181b',
        } : {
          background: '#ffffff',
          primaryColor: '#f4f4f5',
          primaryTextColor: '#09090b',
          primaryBorderColor: 'rgba(9, 9, 11, 0.16)',
          lineColor: '#71717a',
          secondaryColor: '#e4e4e7',
          tertiaryColor: '#f4f4f5',
        }
      });

      const containers = document.querySelectorAll('.mermaid-container');
      for (const container of containers) {
        const code = container.getAttribute('data-mermaid-code');
        if (!code) continue;

        try {
          renderId++;
          const svgId = `mermaid-svg-${container.id}-${renderId}`;
          // Pass the container element so Mermaid measures text sizes inside the target DOM context
          const { svg } = await mermaid.render(svgId, code, container);
          container.innerHTML = svg;

          // Adjust SVG properties for clean responsive scaling
          const svgElement = container.querySelector('svg');
          if (svgElement) {
            svgElement.removeAttribute('height');
          }
        } catch (error: any) {
          console.error('Mermaid rendering failed:', error);
          container.innerHTML = `<pre style="color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.05); padding: 12px; border-radius: 6px; font-size: 0.85rem; width: 100%; overflow-x: auto; margin: 0;">图表渲染失败: ${error.message}</pre>`;
        }
      }
    };

    // Wait for web fonts (e.g. Inter) to be fully loaded to ensure browser text measurements are accurate
    const init = async () => {
      if (document.fonts && document.fonts.ready) {
        await document.fonts.ready;
      }
      await renderCharts();
    };
    init();

    // Re-render when theme changes using MutationObserver
    const observer = new MutationObserver(async (mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
          await renderCharts();
        }
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  }
</script>

<script>
  // Floating Dock & Share interactions
  const initDockAndShare = () => {
    // 1. Copy URL (Dock + Bottom bar)
    const copyUrlButtons = document.querySelectorAll('[data-dock-copy-url], [data-share-copy]');
    copyUrlButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-dock-copy-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add('is-success', 'copied');

          const dockItem = btn.closest('.dock-item');
          const tooltip = dockItem?.querySelector('.dock-tooltip');
          const origTooltipText = tooltip ? tooltip.textContent : '';
          if (tooltip) {
            tooltip.textContent = document.documentElement.lang.startsWith('zh') || location.pathname.includes('/zh/') ? '✓ 已复制链接' : '✓ Copied link!';
            dockItem?.classList.add('is-copied');
          }

          const textSpan = btn.querySelector('.share-btn-text');
          const origText = textSpan ? textSpan.textContent : '';
          if (textSpan) {
            textSpan.textContent = document.documentElement.lang.startsWith('zh') || location.pathname.includes('/zh/') ? '✓ 已复制' : '✓ Copied!';
          }
          setTimeout(() => {
            btn.classList.remove('is-success', 'copied');
            if (tooltip) {
              tooltip.textContent = origTooltipText;
              dockItem?.classList.remove('is-copied');
            }
            if (textSpan) textSpan.textContent = origText;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    });

    // 2. Copy Markdown citation (Dock + Bottom bar)
    const copyMdButtons = document.querySelectorAll('[data-dock-copy-md], [data-share-copy-md]');
    copyMdButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const mdText = btn.getAttribute('data-dock-copy-md') || btn.getAttribute('data-md-text');
        if (!mdText) return;
        try {
          await navigator.clipboard.writeText(mdText);
          btn.classList.add('is-success', 'copied');

          const dockItem = btn.closest('.dock-item');
          const tooltip = dockItem?.querySelector('.dock-tooltip');
          const origTooltipText = tooltip ? tooltip.textContent : '';
          if (tooltip) {
            tooltip.textContent = document.documentElement.lang.startsWith('zh') || location.pathname.includes('/zh/') ? '✓ 已复制 MD' : '✓ Copied MD!';
            dockItem?.classList.add('is-copied');
          }

          const textSpan = btn.querySelector('.share-btn-text');
          const origText = textSpan ? textSpan.textContent : '';
          if (textSpan) {
            textSpan.textContent = document.documentElement.lang.startsWith('zh') || location.pathname.includes('/zh/') ? '✓ 已复制 MD' : '✓ Copied MD!';
          }
          setTimeout(() => {
            btn.classList.remove('is-success', 'copied');
            if (tooltip) {
              tooltip.textContent = origTooltipText;
              dockItem?.classList.remove('is-copied');
            }
            if (textSpan) textSpan.textContent = origText;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy markdown citation:', err);
        }
      });
    });

    // 3. WeChat QR Popover toggle & outside click
    const wechatWrapper = document.querySelector('.dock-wechat-wrapper');
    const wechatToggle = document.querySelector('[data-dock-wechat-toggle]');
    const qrPopover = document.querySelector('[data-dock-qr-popover]');
    const qrClose = document.querySelector('[data-dock-qr-close]');

    if (wechatToggle && qrPopover) {
      const togglePopover = (open?: boolean) => {
        const isOpen = open !== undefined ? open : !qrPopover.classList.contains('is-open');
        if (isOpen) {
          qrPopover.classList.add('is-open');
          wechatWrapper?.classList.add('has-popover-open');
        } else {
          qrPopover.classList.remove('is-open');
          wechatWrapper?.classList.remove('has-popover-open');
        }
      };

      wechatToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePopover();
      });

      if (qrClose) {
        qrClose.addEventListener('click', (e) => {
          e.stopPropagation();
          togglePopover(false);
        });
      }

      document.addEventListener('click', (e) => {
        if (!qrPopover.contains(e.target as Node) && !wechatToggle.contains(e.target as Node)) {
          togglePopover(false);
        }
      });
    }

    // 4. Back to top (smooth scroll)
    const backToTopBtn = document.querySelector('[data-dock-back-to-top]');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 5. Native Share API (mobile devices & supported browsers)
    const nativeBtn = document.querySelector('[data-share-native]') as HTMLElement | null;
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.style.display = 'inline-flex';
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href
          });
        } catch (err) {
          // User cancelled
        }
      });
    }
  };

  initDockAndShare();
</script>

