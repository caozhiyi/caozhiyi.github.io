---
import MainLayout from "../../../layouts/MainLayout.astro";
import { siteContent, type Locale } from "../../../data/site";

export function getStaticPaths() {
  return (Object.keys(siteContent) as Locale[]).map((locale) => ({
    params: { locale }
  }));
}

const locale = Astro.params.locale as Locale;
const content = siteContent[locale];

if (!content) {
  throw new Error(`Unsupported locale: ${locale}`);
}

// Person schema for knowledge-graph association (data follows author.yaml,
// the canonical author metadata source in this repo root).
const personJsonLd = locale === "zh"
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "曹智轶",
      "alternateName": "Zhiyi Cao",
      "url": "https://caozhiyi.cc/",
      "jobTitle": "系统架构师",
      "sameAs": ["https://github.com/caozhiyi"],
      "knowsAbout": ["分布式系统", "高性能网络", "QUIC", "AI 工程"]
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Zhiyi Cao",
      "alternateName": "曹智轶",
      "url": "https://caozhiyi.cc/",
      "jobTitle": "Systems Architect",
      "sameAs": ["https://github.com/caozhiyi"],
      "knowsAbout": ["Distributed Systems", "High-Performance Networking", "QUIC", "AI Engineering"]
    };

const pageContent = {
  zh: {
    title: "关于",
    paragraphs: [
      "我是曹智轶，现于一线云厂商从事基础设施研发，此前先后在百度、滴滴与博睿宏远工作。",
      "过去十年，我的大部分时间都花在网络协议和底层系统上。这些方向最初都来自工作——先是解决具体问题，接着生出兴趣，最后变成想亲手做点什么。于是有了 quicX 和 CppNet 两个开源协议栈，以及云网络与 AI 编程的两本书。",
      "现在我的主要精力在 AI 工程化：AI 网关、AI 编程系统，以及大模型真正落地时冒出来的那些工程问题。我热衷于从第一性原理出发解构复杂的现实逻辑，并将这些思考落实在自研系统、书籍编写以及长期技术写作中。"
    ],
    mottoQuote: "What I cannot create, I do not understand.",
    mottoAuthor: "— 理查德·费曼 (Richard Feynman)",
    mottoDesc: "复杂系统和协议的细节与边界条件，往往只有亲手去实现一次，才算真正理解。无论是编写底层开源协议栈、出版专著还是做 AI 工程化落地，亲手创造始终是我探寻技术本质喜欢的方式。",
    companiesTitle: "曾服务公司",
    companies: ["一线云厂商 (当前)", "百度", "滴滴", "博睿宏远"],
    asideTitle: "个人快照",
    asideItems: [
      "📍 上海 | Shanghai, CN",
      "💼 十年研发与架构经验",
      "👥 技术管理经验"
    ],
    contactTitle: "联系我",
    contact: {
      email: "caozhiyi5@gmail.com",
      github: "https://github.com/caozhiyi"
    }
  },
  en: {
    title: "About",
    paragraphs: [
      "I'm Zhiyi Cao. I build infrastructure at a leading cloud provider, previously at Baidu, DiDi, and Bonree.",
      "For the past decade, most of my time went into network protocols and low-level systems. Those interests grew out of the work itself — solving concrete problems first, then growing curious, then wanting to build something of my own. That impulse became two open-source stacks (quicX and CppNet) and two books on cloud networking and AI coding.",
      "These days my main focus is AI engineering: AI gateways, AI coding systems, and the engineering problems that surface when large models actually ship. I focus on translating complex real-world logic into runnable code, long-form books, and structured technical writing."
    ],
    mottoQuote: "What I cannot create, I do not understand.",
    mottoAuthor: "— Richard Feynman",
    mottoDesc: "The subtle edge cases of complex systems are truly understood only when built from scratch. Whether developing open-source protocol stacks, authoring technical books, or shipping AI systems, relentless creation remains my preferred way of exploring technology.",
    companiesTitle: "Companies",
    companies: ["Leading Cloud Provider (Current)", "Baidu", "DiDi", "Bonree"],
    asideTitle: "Overview",
    asideItems: [
      "📍 Shanghai, CN",
      "💼 10 Years of R&D",
      "👥 Technical Leadership"
    ],
    contactTitle: "Connect",
    contact: {
      email: "caozhiyi5@gmail.com",
      github: "https://github.com/caozhiyi"
    }
  }
}[locale];

const seoTitle = locale === "zh"
  ? "关于曹智轶 | 一线云厂商系统架构师，深耕底层网络协议与 AI 工程化"
  : "About Zhiyi Cao | Systems Architect, Cloud Infrastructure & AI Engineering";
---

<MainLayout content={content} pageTitle={pageContent.title} fullTitle={seoTitle} description={pageContent.paragraphs[0]} jsonLd={personJsonLd}>
  <div class="about-layout">
    <!-- Left Column: Bio & Companies inside a card panel -->
    <article class="page-panel about-copy">
      <div class="bio-paragraphs">
        {pageContent.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="motto-box">
        <blockquote class="about-motto">
          “{pageContent.mottoQuote}”
        </blockquote>
        <span class="motto-author">{pageContent.mottoAuthor}</span>
        <p class="motto-desc">{pageContent.mottoDesc}</p>
      </div>
      
      <div class="companies-section">
        <h3 class="section-subtitle">{pageContent.companiesTitle}</h3>
        <div class="companies-list">
          {pageContent.companies.map((company, index) => (
            <span>
              {company}
              {index < pageContent.companies.length - 1 && <span class="divider">·</span>}
            </span>
          ))}
        </div>
      </div>
    </article>

    <!-- Right Column: Sidebar info with card panels -->
    <aside class="about-aside">
      <!-- Snapshot Card -->
      <div class="page-panel aside-panel-box">
        <p class="kicker">Snapshot</p>
        <h3>{pageContent.asideTitle}</h3>
        <ul>
          {pageContent.asideItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <!-- Contact Card -->
      <div class="page-panel aside-panel-box">
        <p class="kicker">Get in touch</p>
        <h3>{pageContent.contactTitle}</h3>
        <ul class="contact-list">
          <li>
            <span class="label">Email</span>
            <a href={`mailto:${pageContent.contact.email}`}>{pageContent.contact.email}</a>
          </li>
          <li>
            <span class="label">GitHub</span>
            <a href={pageContent.contact.github} target="_blank" rel="noopener noreferrer">github.com/caozhiyi</a>
          </li>
        </ul>
      </div>
    </aside>
  </div>

  <script define:vars={{ locale }}>
    localStorage.setItem("preferred-locale", locale);
  </script>
</MainLayout>

<style>
  /* Page spacing wrapper */
  .about-layout {
    margin-top: 40px;
  }

  .about-copy {
    display: grid;
    gap: 28px;
  }

  .bio-paragraphs {
    display: grid;
    gap: 16px;
  }

  .about-copy p {
    font-size: 0.96rem;
    line-height: 1.75;
    color: var(--text-soft);
    margin: 0;
  }

  .about-copy p:first-of-type {
    color: var(--text-strong);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .motto-box {
    padding: 18px 22px;
    border-left: 3px solid var(--accent-strong, #3b82f6);
    background: var(--surface-subtle, rgba(255, 255, 255, 0.03));
    border-radius: 0 8px 8px 0;
    display: grid;
    gap: 8px;
    margin: 4px 0;
  }

  .about-motto {
    font-family: 'Space Grotesk', var(--font-sans), sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
    font-style: italic;
    color: var(--text-strong);
    margin: 0;
    line-height: 1.4;
  }

  .motto-author {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-soft);
    letter-spacing: 0.05em;
  }

  .motto-desc {
    font-size: 0.88rem !important;
    line-height: 1.65 !important;
    color: var(--text-soft) !important;
    margin: 0 !important;
  }

  .companies-section {
    padding-top: 24px;
    border-top: 1px dashed var(--line);
  }

  .section-subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-soft);
    margin: 0 0 12px 0;
  }

  .companies-list {
    font-size: 0.95rem;
    color: var(--text-strong);
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .divider {
    margin-left: 12px;
    color: var(--text-soft);
    opacity: 0.5;
  }

  /* Aside panel styles */
  .about-aside {
    display: grid;
    gap: 20px;
  }

  .aside-panel-box {
    display: grid;
    gap: 16px;
  }

  .aside-panel-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .aside-panel-box li {
    font-size: 0.9rem;
    color: var(--text-soft);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-soft);
    width: 50px;
    display: inline-block;
  }

  .aside-panel-box a {
    color: var(--text-strong);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .aside-panel-box a:hover {
    color: var(--accent-strong);
  }
</style>
