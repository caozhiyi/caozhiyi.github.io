---
import MainLayout from "../../../layouts/MainLayout.astro";
import { siteContent, type Locale } from "../../../data/site";

export function getStaticPaths() {
  return (Object.keys(siteContent) as Locale[]).map((locale) => ({
    params: { locale }
  }));
}

const locale = Astro.params.locale as Locale;
const content = siteContent[locale];

if (!content) {
  throw new Error(`Unsupported locale: ${locale}`);
}

const openLabel = locale === "zh" ? "查看仓库" : "View repository";

const seoTitle = locale === "zh"
  ? "开源项目 · 曹智轶 | quicX、CppNet 高性能网络协议栈与基础设施实践"
  : "Open Source Projects · Zhiyi Cao | quicX, CppNet & Network Infrastructure";

const seoDescription = locale === "zh"
  ? "曹智轶的开源项目精选：quicX（自包含 C++17 QUIC 与 HTTP/3 协议栈）与 CppNet（跨平台异步网络库）。"
  : "Open-source infrastructure projects by Zhiyi Cao: quicX (C++17 QUIC/HTTP3 stack) and CppNet (asynchronous networking library).";
---

<MainLayout
  content={content}
  pageTitle={locale === "zh" ? "项目" : "Projects"}
  fullTitle={seoTitle}
  description={seoDescription}
>
  <section class="page-section project-list">
    {content.projects.map((item) => (
      <article class="card project-card">
        {item.logo && (
          <div class="project-logo-wrap">
            <img class="project-logo" src={item.logo.src} alt={item.logo.alt} loading="lazy" />
          </div>
        )}
        <div class="project-copy">
          <p class="card-meta">{item.meta}</p>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
          {item.highlights && (
            <ul class="project-highlights">
              {item.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}
          <div class="project-links">
            <a class="card-link" href={item.href}>{openLabel}</a>
            {item.links?.map((link) => (
              <a class="card-link" href={link.href}>{link.label} ↗</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <script define:vars={{ locale }}>
    localStorage.setItem("preferred-locale", locale);
  </script>
</MainLayout>
