---
import "../styles/global.css";
import "../styles/tech-review.css";
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
  pageTitle: string;
  description?: string;
  pageType?: "website" | "article";
  publishedAt?: string;
  jsonLd?: unknown;
}

const {
  content,
  pageTitle,
  description,
  pageType = "website",
  publishedAt,
  jsonLd
} = Astro.props;
const title = `${pageTitle} · ${content.siteTitle}`;
const isZh = content.homePath.startsWith("/zh");
const localeSlug = isZh ? "zh" : "en";
const keywords = isZh
  ? "曹智轶,AI 编程,系统,网络,QUIC,云网络,长文写作"
  : "Zhiyi Cao, AI programming, systems, networking, QUIC, cloud networking, long-form writing";

const normalizeIsoDate = (value?: string) => {
  if (!value) return undefined;
  if (/^\d{4}-\d{2}-\d{2}T/.test(value)) return value;
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return `${value}T00:00:00+08:00`;
  return value;
};
const publishedAtISO = normalizeIsoDate(publishedAt);
const jsonLdEntries = jsonLd === undefined || jsonLd === null
  ? []
  : Array.isArray(jsonLd)
    ? jsonLd.filter((entry) => entry !== undefined && entry !== null)
    : [jsonLd];
const themeLabels = isZh
  ? {
      title: "主题",
      auto: "跟随系统",
      light: "浅色",
      dark: "深色"
    }
  : {
      title: "Theme",
      auto: "Auto",
      light: "Light",
      dark: "Dark"
    };
const themeColors = {
  light: "#f4efe6",
  dark: "#171513"
};

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://caozhiyi.cc";
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, siteUrl).href;
const rssURL = new URL(`/${localeSlug}/rss.xml`, siteUrl).href;

const oppositePath = pathname.startsWith("/zh/")
  ? pathname.replace(/^\/zh\//, "/en/")
  : pathname.startsWith("/en/")
    ? pathname.replace(/^\/en\//, "/zh/")
    : pathname;
const oppositeURL = new URL(oppositePath, siteUrl).href;

const zhURL = isZh ? canonicalURL : oppositeURL;
const enURL = isZh ? oppositeURL : canonicalURL;
const xDefaultURL = new URL("/zh/", siteUrl).href;

const pageDescription = description || content.siteDescription;
const defaultOgImage = new URL("/images/og/og-default.png", siteUrl).href;
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4J919K537P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4J919K537P');
    </script>

    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="曹智轶 / Zhiyi Cao" />
    <meta name="keywords" content={keywords} />
    <meta name="theme-color" content={themeColors.light} />

    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="zh-CN" href={zhURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />
    <link rel="alternate" type="application/rss+xml" title={`${content.siteTitle} RSS`} href={rssURL} />

    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={defaultOgImage} />
    {publishedAtISO && (
      <meta property="article:published_time" content={publishedAtISO} />
    )}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={defaultOgImage} />

    {jsonLdEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <script is:inline define:vars={{ themeColors }}>
      (() => {
        const storageKey = "preferred-theme";
        const darkMedia = window.matchMedia("(prefers-color-scheme: dark)");

        const readStoredMode = () => {
          const mode = localStorage.getItem(storageKey);
          return mode === "light" || mode === "dark" || mode === "auto" ? mode : "auto";
        };

        const resolveTheme = (mode) => {
          if (mode === "auto") {
            return darkMedia.matches ? "dark" : "light";
          }
          return mode;
        };

        const applyTheme = (mode) => {
          const resolved = resolveTheme(mode);
          const root = document.documentElement;
          root.dataset.themeMode = mode;
          root.dataset.theme = resolved;

          const themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) {
            themeMeta.setAttribute("content", resolved === "dark" ? themeColors.dark : themeColors.light);
          }
        };

        const setMode = (mode) => {
          localStorage.setItem(storageKey, mode);
          applyTheme(mode);
        };

        applyTheme(readStoredMode());

        const handleSystemThemeChange = () => {
          if (readStoredMode() === "auto") {
            applyTheme("auto");
          }
        };

        if (typeof darkMedia.addEventListener === "function") {
          darkMedia.addEventListener("change", handleSystemThemeChange);
        } else if (typeof darkMedia.addListener === "function") {
          darkMedia.addListener(handleSystemThemeChange);
        }

        window.__siteTheme = {
          getMode: readStoredMode,
          setMode,
          applyTheme
        };
      })();
    </script>
  </head>
  <body>
    <div class="site-background" aria-hidden="true">
      <div class="site-glow site-glow-a"></div>
      <div class="site-glow site-glow-b"></div>
      <div class="site-glow site-glow-c"></div>
    </div>

    <div class="site-shell">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="site-brand" href={content.homePath} aria-label={content.siteTitle}>
            <span class="site-brand-copy">
              <strong>{content.siteTitle}</strong>
              <small>{content.siteDescription}</small>
            </span>
          </a>

          <nav class="site-nav" aria-label="Primary">
            {content.nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <div class="site-header-actions">
            <button class="theme-switch" type="button" data-theme-toggle>
              <span class="theme-switch-title">{themeLabels.title}</span>
              <span class="theme-switch-value" data-theme-value>{themeLabels.auto}</span>
            </button>
            <a class="locale-switch" href={content.oppositeLocale.href}>{content.oppositeLocale.label}</a>
          </div>
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p>{content.footer}</p>
          <a class="footer-link" href="https://github.com/caozhiyi" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </footer>
    </div>

    <script is:inline define:vars={{ themeLabels }}>
      (() => {
        const button = document.querySelector("[data-theme-toggle]");
        const valueNode = document.querySelector("[data-theme-value]");
        const modes = ["auto", "light", "dark"];

        if (!button || !valueNode || !window.__siteTheme) {
          return;
        }

        const render = () => {
          const mode = window.__siteTheme.getMode();
          valueNode.textContent = themeLabels[mode];
          button.setAttribute("aria-label", `${themeLabels.title}: ${themeLabels[mode]}`);
          button.dataset.mode = mode;
        };

        button.addEventListener("click", () => {
          const currentMode = window.__siteTheme.getMode();
          const nextMode = modes[(modes.indexOf(currentMode) + 1) % modes.length];
          window.__siteTheme.setMode(nextMode);
          render();
        });

        render();
      })();
    </script>
  </body>
</html>
